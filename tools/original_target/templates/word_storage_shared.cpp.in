// Original region: 0x@ENTRY@ (93 body bytes, 3 independently frozen NOP bytes).
// Exact target SHA256: @TARGET_SHA256@.
// Purpose: initialize an inferred four-byte-element storage wrapper.
// Class/API identity and the three unknown field purposes remain unresolved.

extern "C" void* __cdecl allocate_storage_@ENTRY@(unsigned int byte_count);
extern "C" unsigned char base_dispatch_@ENTRY@[];
extern "C" unsigned char derived_dispatch_@ENTRY@[];

#include "shared/word_storage_layout.hpp"

WordStorage_@ENTRY@* WordStorage_@ENTRY@::initialize(
    unsigned int requested_capacity,
    unsigned int* supplied_storage)
{
    storage = 0;
    capacity = requested_capacity;
    unknown_0x0c = 1;
    owns_storage = 0;
    dispatch_table = base_dispatch_@ENTRY@;

    // A zero capacity ignores even a nonnull supplied pointer.
    if (requested_capacity != 0) {
        if (supplied_storage != 0) {
            storage = supplied_storage;
        } else {
            // Preserve 32-bit wrapping and ownership even on a null result.
            storage = (unsigned int*)allocate_storage_@ENTRY@(requested_capacity << 2);
            owns_storage = 1;
        }
    }

    dispatch_table = derived_dispatch_@ENTRY@;
    // The literal ten alone does not identify the role of field 0x14.
    unknown_0x14 = 10;
    unknown_0x10 = 0;
    return this;
}
